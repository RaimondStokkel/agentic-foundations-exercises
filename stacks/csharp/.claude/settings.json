{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet test)",
      "PowerShell(dotnet test)",
      "Bash(dotnet test *)",
      "PowerShell(dotnet test *)",
      "Edit(./src/**)"
    ],
    "ask": [
      "Edit(./tests/**)",
      "Edit(./Triage.csproj)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./hooks/**)",
      "Bash(git commit *)",
      "PowerShell(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/**)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/guard.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
